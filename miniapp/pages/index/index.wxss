.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.label { width: 140rpx; color: #6b7280; }
.row input { flex: 1; border-bottom: 1rpx solid #e5e7eb; padding: 8rpx 0; }
.row + .row { margin-top: 18rpx; }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.thumb { width: 180rpx; height: 180rpx; border-radius: 12rpx; position: relative; overflow: hidden; background: #eef2f7; }
.thumb-img { width: 100%; height: 100%; }
.thumb-add, .add { display: flex; align-items: center; justify-content: center; font-size: 56rpx; color: #9ca3af; }
.thumb-del { position: absolute; right: 6rpx; top: 6rpx; width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center; border-radius: 50%; background: rgba(0,0,0,0.5); color: #fff; }

/* 热量刻度色带：三段等长，从左往右逐步填，未到的位置留空 */
.band { margin-top: 22rpx; }
.band-wrap { position: relative; padding: 10rpx 0 14rpx; }
.band-track { display: flex; height: 26rpx; border-radius: 13rpx; overflow: hidden; background: #f3f4f6; }
.band-seg { flex: 1; position: relative; height: 100%; }
.band-seg + .band-seg { border-left: 3rpx solid #ffffff; }
.band-fill { height: 100%; }
.fill-y { background: #f0bf3a; }
.fill-g { background: #3fae6a; }
.fill-r { background: #e06666; }
.band-mark { position: absolute; bottom: 4rpx; width: 8rpx; height: 38rpx; margin-left: -4rpx; background: #1f2937; border-radius: 4rpx; }
.band-labels { display: flex; margin-top: 4rpx; }
.lbl { flex: 1; font-size: 22rpx; }
.lbl-y { color: #a1680b; text-align: left; }
.lbl-g { color: #1f7a4d; text-align: center; }
.lbl-r { color: #a83a3a; text-align: right; }
.dish { padding: 18rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.divider { height: 1rpx; background: #e5e7eb; margin: 16rpx 0; }
.ratios { display: flex; flex-wrap: wrap; gap: 16rpx; }
.ratio { padding: 16rpx 24rpx; border-radius: 12rpx; background: #eef2f7; color: #1f2329; }
.ratio.active { background: #16a34a; color: #fff; }